{
  "manifest_version": 3,
  "name": "Instagram DM Automation Pro",
  "version": "1.0.1",
  "description": "Automate Instagram DMs and follows with human-like behavior",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "notifications",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://script.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://script.google.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content-script.js"],
      "matches": ["https://www.instagram.com/*"]
    }
  ],
  "action": {
    "default_title": "Open Instagram DM Automation Dashboard"
  },
  "options_page": "dashboard/dashboard.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
